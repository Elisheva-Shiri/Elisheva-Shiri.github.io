---
// Archive: every project that is not one of the selected ones on the homepage,
// organised into chapters by how it meets the human body (`chapter` in each
// project file; the chapters themselves are listed in src/site.config.ts).
// Cards open the quick-view pop-up; without JavaScript they are plain links.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPopup from '../../components/ProjectPopup.astro';
import { getProjects, getSelected, groupByChapter, initials, projectUrl, projectYear, withBase } from '../../lib/projects';

const projects = await getProjects();
const chapters = groupByChapter(projects);
const selected = getSelected(projects);
const total = chapters.reduce((n, chapter) => n + chapter.projects.length, 0);
const years = projects.map((p) => p.data.date?.slice(0, 4) ?? '').filter(Boolean).sort();
const lastYears = projects.map((p) => (p.data.dateEnd ?? p.data.date ?? '').slice(0, 4)).filter(Boolean).sort();
const span = years.length ? ` · ${years[0]}–${lastYears.at(-1)}` : '';
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="Archive" description={`${total} more projects, organised by how they meet the human body.`}>
  <div data-archive>
    <section class="container intro">
      <p class="kicker kicker-pink">ARCHIVE · {total} MORE PROJECTS{span}</p>
      <h1>Everything else, organised by how it meets the <span class="pink">human body</span>.</h1>
      <p class="lead">
        Eight chapters: machines that move, touch, body signals, spaces you step into, tools built with one person, play, research — and
        the art underneath it all.
      </p>
    </section>

    <section class="container controls" hidden data-enhanced>
      <div class="pills" role="group" aria-label="Choose a chapter">
        <button class="pill" type="button" data-chapter="all" aria-pressed="true" style="--on: var(--foreground)">All chapters <sup>{total}</sup></button>
        {
          chapters.map((chapter) => (
            <button class="pill" type="button" data-chapter={chapter.id} aria-pressed="false" style={`--on: ${chapter.color}`}>
              {chapter.title} <sup>{chapter.projects.length}</sup>
            </button>
          ))
        }
      </div>
      <div class="status">
        <span><span data-status>Showing {total} of {total} archive projects</span> · click any card to open it</span>
        <div class="segmented" role="group" aria-label="Order">
          <button class="pill" type="button" data-sort="curated" aria-pressed="true">Curated</button>
          <button class="pill" type="button" data-sort="newest" aria-pressed="false">Newest first</button>
        </div>
      </div>
    </section>

    {
      chapters.map((chapter, i) => (
        <section class="band chapter" data-chapter-section={chapter.id} style={`--col: ${chapter.color}`}>
          <div class="container chapter-inner">
            <div class="chapter-head reveal">
              <p class="chapter-count">{pad(i + 1)} · {chapter.projects.length} {chapter.projects.length === 1 ? 'PROJECT' : 'PROJECTS'}</p>
              <h2>{chapter.title}</h2>
              <p class="chapter-blurb">{chapter.blurb}</p>
              <span class="chapter-bar" aria-hidden="true" />
            </div>
            <ul class="cards" data-cards>
              {
                chapter.projects.map((project, order) => {
                  const { title, summary, short, cover } = project.data;
                  return (
                    <li data-order={order} data-date={project.data.dateEnd ?? project.data.date ?? ''}>
                      <a class="card" href={projectUrl(project)} data-open={project.id}>
                        <span class="card-media">
                          {cover ? (
                            <img src={withBase(cover)} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <span class="placeholder" style={`--col: ${chapter.color}`}>{initials(title)}</span>
                          )}
                        </span>
                        <span class="card-body">
                          <span class="card-meta">
                            <span>{projectYear(project.data) || '—'}</span>
                            <span class="card-view">View ⤢</span>
                          </span>
                          <span class="card-title">{title}</span>
                          <span class="card-line">{short ?? summary}</span>
                        </span>
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </section>
      ))
    }

    <section class="band band-alt">
      <div class="container back">
        <p>Looking for the main projects?</p>
        <a class="button back-button" href={withBase('/#work')}>← Back to the {selected.length} main projects</a>
      </div>
    </section>
  </div>

  <ProjectPopup projects={projects} />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');

  if (root) {
    const sections = [...root.querySelectorAll<HTMLElement>('[data-chapter-section]')];
    const chapterButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
    const sortButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-sort]')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const total = root.querySelectorAll('[data-cards] > li').length;
    root.querySelectorAll<HTMLElement>('[data-enhanced]').forEach((el) => (el.hidden = false));

    // Cards ease in one after another whenever the set on screen changes.
    const replay = (section: HTMLElement) => {
      section.querySelectorAll<HTMLElement>('[data-cards] > li').forEach((item, i) => {
        item.style.setProperty('--i', String(Math.min(i, 12)));
        item.classList.remove('enter');
        void item.offsetWidth;
        item.classList.add('enter');
      });
    };

    // --- Chapters ---
    const applyChapter = (id: string) => {
      let shown = 0;
      for (const section of sections) {
        const match = id === 'all' || section.dataset.chapterSection === id;
        if (match && (section.hidden || id !== 'all')) replay(section);
        section.hidden = !match;
        if (match) shown += section.querySelectorAll('[data-cards] > li').length;
      }
      chapterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chapter === id)));
      status.textContent = `Showing ${shown} of ${total} archive projects`;
    };
    chapterButtons.forEach((button) =>
      button.addEventListener('click', () => {
        const id = button.dataset.chapter!;
        applyChapter(id);
        history.replaceState(null, '', id === 'all' ? location.pathname : `#${id}`);
      }),
    );
    // "/projects/#touch" opens one chapter.
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (chapterButtons.some((b) => b.dataset.chapter === id)) applyChapter(id);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);

    // --- Order inside each chapter ---
    sortButtons.forEach((button) =>
      button.addEventListener('click', () => {
        const newest = button.dataset.sort === 'newest';
        for (const section of sections) {
          const list = section.querySelector<HTMLElement>('[data-cards]')!;
          const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
          items.sort((a, b) =>
            newest ? b.dataset.date!.localeCompare(a.dataset.date!) || Number(a.dataset.order) - Number(b.dataset.order) : Number(a.dataset.order) - Number(b.dataset.order),
          );
          list.append(...items);
          if (!section.hidden) replay(section);
        }
        sortButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      }),
    );
  }
</script>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 40px 32px;
  }

  .intro > * {
    animation: rise-in 800ms var(--ease) both;
  }

  .intro > :nth-child(2) {
    animation-delay: 80ms;
  }

  .intro > :nth-child(3) {
    animation-delay: 160ms;
  }

  h1 {
    max-width: 1100px;
    margin: 0;
    font-size: clamp(2.25rem, 5.6vw, 4.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .lead {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 24px;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .status .pill {
    font-family: var(--font-sans);
  }

  .chapter {
    scroll-margin-top: 1rem;
  }

  .chapter-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding-block: 56px;
  }

  .chapter-head {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    max-width: 360px;
  }

  @media (min-width: 64rem) {
    .chapter-head {
      position: sticky;
      top: 24px;
      align-self: flex-start;
    }
  }

  .chapter-count {
    margin: 0;
    color: var(--col);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  h2 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .chapter-blurb {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .chapter-bar {
    width: 56px;
    height: 3px;
    border-radius: 3px;
    background: var(--col);
  }

  .cards {
    flex: 999 1 560px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 14px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cards li {
    display: flex;
  }

  .cards li.enter {
    animation: rise-in 480ms var(--ease) both;
    animation-delay: calc(var(--i) * 45ms);
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    color: var(--foreground);
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .card:hover {
    border-color: #4a4a6a;
    color: var(--foreground);
    transform: translateY(-2px);
  }

  .card-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    background: var(--placeholder);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .card:hover .card-media img {
    transform: scale(1.04);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 18px 18px;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .card-view {
    color: var(--col);
  }

  .card-title {
    font-weight: 700;
    line-height: 1.3;
  }

  .card-line {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .back {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 56px;
  }

  .back p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .back-button {
    border-color: var(--cyan);
    background: var(--cyan);
    color: var(--accent-foreground);
  }

  .back-button:hover {
    border-color: var(--foreground);
    background: var(--foreground);
    color: var(--accent-foreground);
  }
  /* Phones: chapter chips in one sideways row, and two small cards per row */
  @media (max-width: 40rem) {
    .intro {
      gap: 14px;
      padding-block: 20px 20px;
    }

    h1 {
      font-size: 2rem;
    }

    .lead {
      font-size: 0.9375rem;
    }

    .controls .pills {
      flex-wrap: nowrap;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .controls .pill {
      flex: none;
    }

    .chapter-inner {
      gap: 16px;
      padding-block: 32px;
    }

    .chapter-head {
      gap: 6px;
    }

    h2 {
      font-size: 1.25rem;
    }

    .chapter-blurb {
      font-size: 0.8125rem;
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .card {
      border-radius: 12px;
    }

    .card-body {
      gap: 4px;
      padding: 8px 10px 12px;
    }

    .card-meta {
      font-size: 0.625rem;
    }

    .card-view,
    .card-line {
      display: none;
    }

    .card-title {
      font-size: 0.8125rem;
    }

    .back {
      padding-block: 32px;
    }
  }
</style>
