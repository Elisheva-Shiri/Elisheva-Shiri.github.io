---
// Homepage: headline, the live lab, About & contact, selected work and "What I bring".
// The work section is built from the project files — nothing to edit here when
// adding a project. `featured: true` puts a project first; the chips filter by
// category and show the top six of each.
import BaseLayout from '../layouts/BaseLayout.astro';
import Lab from '../components/Lab.astro';
import ProjectPopup from '../components/ProjectPopup.astro';
import { getProjects, getSelected, groupByCategory, initials, projectColor, projectUrl, projectYear, slugify, withBase } from '../lib/projects';
import { BRING, LOOP, RESUME, SITE } from '../site.config';

const SHOWN = 6;
const projects = await getProjects();
const categories = groupByCategory(projects);
const selected = getSelected(projects);
// Card order: the main projects, the lead project, then those with both lenses written,
// then the rest (each newest first).
const hasLenses = (p: (typeof projects)[number]) => Boolean(p.data.mechanics && p.data.human);
const others = projects.filter((p) => !p.data.featured);
const lead = others.filter((p) => p.id === SITE.leadProject);
const ranked = [
  ...selected,
  ...lead,
  ...others.filter((p) => !lead.includes(p) && hasLenses(p)),
  ...others.filter((p) => !lead.includes(p) && !hasLenses(p)),
];
const chips = [
  { name: 'Main projects', slug: 'main', projects: selected, focus: true },
  { name: 'All', slug: 'all', projects, focus: false },
  ...categories.map((c) => ({ ...c, focus: false })),
];
const initial = chips[0];
const initialIds = new Set(ranked.filter((p) => initial.projects.includes(p)).slice(0, SHOWN).map((p) => p.id));
const archiveCount = projects.length - selected.length;
const archive = withBase('/projects/');
const resume = withBase('/resume/');
const pad = (n: number) => String(n).padStart(2, '0');
// The address, written backwards and without "@"; the script below rebuilds it on click.
const mailCode = [...`${SITE.email.name}|${SITE.email.domain}`].reverse().join('');
let shownSoFar = 0;
---

<BaseLayout>
  <section class="hero container">
    <p class="kicker kicker-pink hero-role"><span class="blink" aria-hidden="true"></span>{SITE.role}</p>
    <h1>I build machines people can <span class="cyan">feel</span>, <span class="cyan">read</span> and <span class="pink">trust</span>.</h1>
    <p class="hero-intro">{SITE.intro}</p>
  </section>

  <Lab />

  <section class="band band-alt" id="contact" aria-labelledby="contact-heading">
    <div class="container section contact">
      <div class="contact-main reveal">
        <p class="kicker">ABOUT &amp; CONTACT</p>
        <h2 class="display" id="contact-heading">{SITE.about.heading}</h2>
        {SITE.about.text.map((paragraph) => <p class="contact-text">{paragraph}</p>)}
        <p class="contact-links">
          <a class="button button-primary" href="#contact" data-mail={mailCode}>Email me</a>
          {SITE.links.map((link) => <a class="button" href={link.href}>{link.label}</a>)}
          <a class="button" href={resume}>Full resume →</a>
        </p>
      </div>
      <dl class="cv reveal">
        {
          RESUME.education.map((entry) => (
            <div>
              <dt>{entry.when}</dt>
              <dd>
                {entry.title}
                <span>{entry.where}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band" id="work" aria-labelledby="work-heading" data-work data-lens="both">
    <div class="container section">
      <div class="work-head reveal">
        <div class="section-intro">
          <p class="kicker">01 · MAIN PROJECTS</p>
          <h2 class="display" id="work-heading">Every machine has two bodies: the one I build, and the one people feel.</h2>
        </div>
        <div class="segmented lens-toggle" role="group" aria-label="Choose lens" hidden data-enhanced>
          <button class="pill" type="button" data-lens-pick="both" aria-pressed="true" style="--on: var(--foreground)">Both</button>
          <button class="pill" type="button" data-lens-pick="mech" aria-pressed="false">Mechanics</button>
          <button class="pill" type="button" data-lens-pick="human" aria-pressed="false" style="--on: var(--pink)">Human</button>
        </div>
      </div>

      <div class="work-filter">
        <div class="pills" role="group" aria-label="Filter projects by discipline" hidden data-enhanced>
          {
            chips.map((chip, i) => (
              <button
                class:list={['pill', { focus: chip.focus }]}
                type="button"
                data-filter={chip.slug}
                data-count={chip.projects.length}
                data-focus={chip.focus ? '' : undefined}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {chip.name} <sup>{chip.projects.length}</sup>
              </button>
            ))
          }
        </div>
        <p class="work-status">
          <span data-status>{initialIds.size} main projects</span>
          <a href={archive}>More projects · {archiveCount} →</a>
        </p>
      </div>

      <div class="work-grid" data-cards>
        {
          ranked.map((project) => {
            const { title, summary, short, cover, coverAlt, categories: cats, mechanics, human, tools, tags } = project.data;
            const visible = initialIds.has(project.id);
            const number = visible ? ++shownSoFar : 0;
            const url = projectUrl(project);
            const chipsShown = tools.length > 0 ? tools : tags.slice(0, 3);
            return (
              <article class="work-card" data-cats={[...(project.data.featured ? ['main'] : []), ...cats.map(slugify)].join(' ')} hidden={!visible} style={`--i: ${Math.max(0, number - 1)}`}>
                <a class="work-media" href={url} data-open={project.id} aria-label={`Quick view: ${title}`}>
                  {cover ? (
                    <img src={withBase(cover)} alt={coverAlt ?? ''} loading="lazy" decoding="async" />
                  ) : (
                    <span class="placeholder" style={`--col: ${projectColor(project)}`}>{initials(title)}</span>
                  )}
                </a>
                <p class="work-meta">
                  <span><span class="pink" data-number>{pad(number)}</span><span class="cats"> · {cats.join(' · ').toUpperCase()}</span></span>
                  <span>{projectYear(project.data)}</span>
                </p>
                <h3><a href={url} data-open={project.id}>{title}</a></h3>
                {mechanics && human ? (
                  <div class="lenses">
                    <div class="lens lens-mech">
                      <span class="lens-label">◆ MECHANICS</span>
                      <p>{mechanics}</p>
                    </div>
                    <div class="lens lens-human">
                      <span class="lens-label">● HUMAN</span>
                      <p>{human}</p>
                    </div>
                  </div>
                ) : (
                  <p class="work-summary">{short ?? summary}</p>
                )}
                <div class="work-foot">
                  <ul class="tools">
                    {chipsShown.map((tool) => <li>{tool}</li>)}
                  </ul>
                  <a class="pill quick" href={url} data-open={project.id}>View project ⤢</a>
                </div>
              </article>
            );
          })
        }
      </div>

      <div class="more reveal">
        <div>
          <p class="more-title">{archiveCount} more projects</p>
          <p class="more-text">Touch, body signals, mechanisms, immersive spaces, assistive tech, play, research and art.</p>
        </div>
        <a class="button button-light" href={archive}>See more projects →</a>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="stack" aria-labelledby="stack-heading">
    <div class="container section">
      <div class="section-intro reveal">
        <p class="kicker">02 · WHAT I BRING</p>
        <h2 class="display" id="stack-heading">Mechanism, embodiment, intelligence.</h2>
      </div>
      <div class="bring">
        {
          BRING.map((column) => (
            <div class:list={['bring-card', 'reveal', column.kind]}>
              <p class="bring-label">{column.label}</p>
              <h3>{column.title}</h3>
              <ul>
                {column.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <ol class="loop" aria-label="The human–robot loop">
        {
          LOOP.map((step, i) => (
            <li class:list={['node', step.kind]} style={`animation-delay: ${i * 1.5}s`}>
              <span class="node-label">{step.label}</span>
              <span class="node-text">{step.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ProjectPopup projects={projects} />
</BaseLayout>

<script>
  // "Email me": the address is only put together at the moment of the click.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-mail]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const [name, domain] = [...link.dataset.mail!].reverse().join('').split('|');
      location.href = `mailto:${name}@${domain}`;
    });
  }

  const work = document.querySelector<HTMLElement>('[data-work]');

  if (work) {
    const SHOWN = 6;
    const cards = [...work.querySelectorAll<HTMLElement>('.work-card')];
    const filters = [...work.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const lensButtons = [...work.querySelectorAll<HTMLButtonElement>('[data-lens-pick]')];
    const status = work.querySelector<HTMLElement>('[data-status]')!;
    work.querySelectorAll<HTMLElement>('[data-enhanced]').forEach((el) => (el.hidden = false));

    // --- Category chips: show the first six matching cards (cards are already in rank order) ---
    const applyFilter = (button: HTMLButtonElement) => {
      const slug = button.dataset.filter!;
      let shown = 0;
      for (const card of cards) {
        const match = slug === 'all' || card.dataset.cats!.split(' ').includes(slug);
        const show = match && shown < SHOWN;
        card.hidden = !show;
        if (!show) continue;
        card.style.setProperty('--i', String(shown));
        card.querySelector('[data-number]')!.textContent = String(++shown).padStart(2, '0');
        // Restart the entrance animation so the new set eases in, one card after another.
        card.classList.remove('enter');
        void card.offsetWidth;
        card.classList.add('enter');
      }
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      const name = button.firstChild!.textContent!.trim();
      status.textContent =
        button.hasAttribute('data-focus')
          ? `${shown} main project${shown === 1 ? '' : 's'}`
          : `${shown} of ${button.dataset.count} ${name === 'All' ? '' : name.toLowerCase() + ' '}projects shown`;
    };
    filters.forEach((button) =>
      button.addEventListener('click', () => {
        applyFilter(button);
        history.replaceState(null, '', button === filters[0] ? '#work' : `#${button.dataset.filter}`);
      }),
    );
    // Links like "/#electronics" (from project pages) open the work section filtered.
    const fromHash = () => {
      const slug = decodeURIComponent(location.hash.slice(1));
      const button = filters.find((b) => b.dataset.filter === slug);
      if (button) {
        applyFilter(button);
        work.scrollIntoView();
      }
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);

    // --- Lens: read every card as mechanics, as human experience, or both ---
    lensButtons.forEach((button) =>
      button.addEventListener('click', () => {
        work.dataset.lens = button.dataset.lensPick;
        lensButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      }),
    );
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 48px 32px;
  }

  .hero > * {
    animation: rise-in 800ms var(--ease) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .blink {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink);
    animation: blink 1.6s ease-in-out infinite;
  }

  h1 {
    max-width: 1180px;
    margin: 0;
    font-size: var(--font-size-display);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero-intro {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1.1875rem;
    line-height: 1.55;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: var(--space-xl);
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  [id] {
    scroll-margin-top: 1rem;
  }

  /* ---------- What I bring ---------- */
  /* One box at every width: mechanics, human and intelligence side by side,
     split by single lines — it never wraps into separate cards. */
  .bring {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  .bring-card {
    --col: var(--cyan);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px;
  }

  .bring-card + .bring-card {
    border-left: 1px solid var(--border);
  }

  .bring-card.human {
    --col: var(--pink);
  }

  .bring-card.mind {
    --col: var(--foreground);
  }

  .bring-label {
    margin: 0;
    color: var(--col);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .bring-card h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .bring-card ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* The loop: each step lights up in turn, then the cycle repeats. */
  .loop {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1.5px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    animation: pulse-node 6s linear infinite;
  }

  @keyframes pulse-node {
    0%,
    20% {
      border-color: var(--border);
      box-shadow: none;
    }

    5%,
    15% {
      border-color: var(--pink);
      box-shadow: 0 0 28px rgb(255 111 181 / 0.22);
    }
  }

  .node-label {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .node.human .node-label {
    color: var(--pink);
  }

  .node-text {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  /* ---------- Selected work ---------- */
  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .lens-toggle {
    padding: 4px;
    background: var(--background);
  }

  .work-filter {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pill.focus {
    --on: var(--pink);
    border-color: #6a2d50;
  }

  .work-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 560px), 1fr));
    gap: 20px;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    transition: border-color var(--transition);
  }

  .work-card:hover {
    border-color: #4a4a6a;
  }

  .work-card.enter {
    animation: rise-in 520ms var(--ease) both;
    animation-delay: calc(var(--i) * 70ms);
  }

  .work-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--placeholder);
    cursor: zoom-in;
  }

  .work-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .work-card:hover .work-media img,
  .work-media:focus-visible img {
    transform: scale(1.035);
  }

  .work-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .work-card h3 {
    margin: 0;
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .lenses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  [data-lens='mech'] .lens-human,
  [data-lens='human'] .lens-mech {
    display: none;
  }

  .work-summary {
    margin: 0;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .work-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
  }

  .work-card h3 a {
    color: inherit;
  }

  .work-card h3 a:hover {
    color: var(--cyan);
  }

  .quick {
    display: inline-flex;
    align-items: center;
    border-color: var(--border-strong);
    color: var(--foreground);
  }

  .quick:hover {
    border-color: var(--foreground);
    color: var(--foreground);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 26px;
    border: 1px dashed var(--border-strong);
    border-radius: 20px;
  }

  .more p {
    margin: 0;
  }

  .more-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .more-text {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ---------- About & contact ---------- */
  .contact {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 48px;
  }

  .contact-main {
    flex: 999 1 520px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .contact-text {
    max-width: 640px;
    margin: 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }

  .cv {
    flex: 1 1 320px;
    align-self: flex-start;
    min-width: 0;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  .cv div {
    padding: 20px 24px;
  }

  .cv div + div {
    border-top: 1px solid var(--border-soft);
  }

  .cv dt {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .cv dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .cv dd span {
    display: block;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  /* ---------- Phones: keep the desktop layout, smaller, instead of one long column ---------- */
  @media (max-width: 40rem) {
    .hero {
      gap: 14px;
      padding-block: 20px 16px;
    }

    .hero-role {
      font-size: 0.6875rem;
    }

    h1 {
      font-size: 2rem;
    }

    .hero-intro {
      font-size: 0.9375rem;
    }

    .section {
      gap: 24px;
      padding-block: 44px;
    }

    .display {
      font-size: 1.5rem;
    }

    /* About: the text and the education list side by side would be too narrow, so both shrink */
    .contact {
      gap: 24px;
    }

    .contact-main {
      gap: 14px;
    }

    .contact-text {
      font-size: 0.9375rem;
    }

    .contact-links {
      gap: 8px;
    }

    .cv div {
      padding: 12px 16px;
    }

    .cv dd {
      font-size: 0.9375rem;
    }

    .cv dd span {
      font-size: 0.8125rem;
    }

    /* Work: chips in one sideways row, and a two-column grid of image + title */
    .work-filter .pills {
      flex-wrap: nowrap;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .work-filter .pill {
      flex: none;
    }

    .lens-toggle,
    .work-card .lenses,
    .work-summary,
    .work-foot,
    .cats {
      display: none;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .work-card {
      gap: 8px;
      padding: 8px 8px 12px;
      border-radius: 14px;
    }

    .work-media {
      aspect-ratio: 4 / 3;
      border-radius: 10px;
    }

    .work-meta {
      padding-inline: 4px;
      font-size: 0.625rem;
    }

    .work-card h3 {
      padding-inline: 4px;
      font-size: 0.875rem;
      line-height: 1.3;
    }

    .more {
      padding: 16px;
    }

    .more-title {
      font-size: 1rem;
    }

    .more-text {
      font-size: 0.8125rem;
    }

    /* What I bring: still three columns in one box, at a smaller scale */
    .bring {
      border-radius: 14px;
    }

    .bring-card {
      gap: 6px;
      padding: 10px 8px;
    }

    .bring-label {
      font-size: 0.5rem;
    }

    .bring-card h3 {
      font-size: 0.75rem;
      line-height: 1.25;
    }

    .bring-card ul {
      gap: 5px;
      padding-left: 10px;
      font-size: 0.625rem;
      line-height: 1.35;
    }

    .loop {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .node {
      gap: 4px;
      padding: 12px;
      border-radius: 12px;
    }

    .node-label {
      font-size: 0.5625rem;
    }

    .node-text {
      font-size: 0.8125rem;
    }
  }
</style>
