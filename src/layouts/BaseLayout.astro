---
// The shell around every page: <head> metadata, header navigation and footer.
import '../styles/global.css';
import { SITE } from '../site.config';
import { withBase } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(withBase(image), Astro.site).href : undefined;
const home = withBase('/');
const isHome = Astro.url.pathname === home || Astro.url.pathname === home.replace(/\/$/, '');
const archive = withBase('/projects/');
const resume = withBase('/resume/');
const [first, ...rest] = SITE.name.toUpperCase().split(' ');
const nav = [
  { label: 'Home', href: home, current: isHome },
  { label: 'About', href: withBase('/#contact') },
  { label: 'Works', href: archive, current: Astro.url.pathname === archive },
  { label: 'Resume', href: resume, current: Astro.url.pathname.replace(/\/$/, '') === resume.replace(/\/$/, '') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1016" />
    <script is:inline>
      // Runs before anything is drawn, so a remembered choice shows straight away.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;700&family=Unbounded:wght@500;700;800&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header container">
      <a class="site-name" href={home} aria-current={isHome ? 'page' : undefined} aria-label={SITE.name}>
        {first}{rest.map((word, i) => <><span class={i % 2 ? 'cyan' : 'pink'} aria-hidden="true">·</span>{word}</>)}
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((item) => <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to the bright theme">
        <span class="theme-dot" aria-hidden="true"></span>
        <span data-theme-label>Dark</span>
      </button>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer band band-alt">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="footer-links">
          {SITE.links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={isHome ? '#lab' : '#main'}>{isHome ? 'Back to the lab ↑' : 'Back to top ↑'}</a>
        </span>
      </div>
    </footer>
    <script>
      // The switch between the dark and the bright theme.
      const root = document.documentElement;
      const meta = document.querySelector('meta[name="theme-color"]');
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        const label = button.querySelector('[data-theme-label]')!;
        const paint = () => {
          const light = root.dataset.theme === 'light';
          button.setAttribute('aria-pressed', String(light));
          button.setAttribute('aria-label', light ? 'Switch to the dark theme' : 'Switch to the bright theme');
          label.textContent = light ? 'Bright' : 'Dark';
          meta?.setAttribute('content', light ? '#f3f0f4' : '#0a1016');
        };
        paint();
        button.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
          try {
            localStorage.setItem('theme', root.dataset.theme);
          } catch {}
          paint();
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
  }

  .site-name {
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .site-name:hover {
    color: var(--foreground);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  nav a[aria-current='page'] {
    color: var(--pink);
  }

  /* Phones: name and nav stay compact; the nav scrolls sideways in one row. */
  @media (max-width: 40rem) {
    .site-header {
      gap: 10px;
      padding-block: 14px;
    }

    nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav ul {
      flex-wrap: nowrap;
      gap: 18px;
      white-space: nowrap;
    }

    nav a {
      font-size: 0.75rem;
    }
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--foreground);
  }

  .theme-dot {
    width: 10px;
    height: 10px;
    border: 1px solid var(--cyan);
    border-radius: 50%;
    /* Half filled: the half that is lit swaps with the theme. */
    background: linear-gradient(90deg, var(--cyan) 50%, transparent 50%);
  }

  :root[data-theme='light'] .theme-dot {
    background: linear-gradient(90deg, transparent 50%, var(--cyan) 50%);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--faint);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 24px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
</style>
