---
// The shell around every page: <head> metadata, header navigation and footer.
import '../styles/global.css';
import { SITE } from '../site.config';
import { withBase } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(withBase(image), Astro.site).href : undefined;
const home = withBase('/');
const isHome = Astro.url.pathname === home || Astro.url.pathname === home.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="container" aria-label="Main">
        <a class="site-name" href={home} aria-current={isHome ? 'page' : undefined}>{SITE.name}</a>
        <ul>
          <li><a href={home}>Projects</a></li>
          {SITE.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-md);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--foreground);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .site-name {
    font-weight: 700;
    font-size: var(--font-size-lg);
    letter-spacing: -0.01em;
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--font-size-sm);
  }
</style>
