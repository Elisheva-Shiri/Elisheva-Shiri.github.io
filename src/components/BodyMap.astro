---
// "Where it meets the body": a body figure with a numbered point for every place
// the project touches a person. Pink points read the body (body → machine), cyan
// points act on it (machine → body). Filled from a project's `body` list.
// A point can sit on the body, be the whole body (a ring around the figure), or
// sit outside it (a dotted line shows what it relates to).
import { BODY_ANCHORS, BODY_POINTS, type BodyPoint } from '../site.config';

interface Props {
  points: { at: string; dir: 'in' | 'out'; label: string }[];
}

const points = Astro.props.points.map((point, i) => {
  const at = point.at as BodyPoint;
  const [x, y] = BODY_POINTS[at];
  return { ...point, x, y, n: i + 1, whole: at === 'whole', anchor: BODY_ANCHORS[at], ground: at === 'ground' };
});
const summary = 'Body map: ' + points.map((p) => p.label).join('; ');
---

<div class="body-map">
  <svg viewBox="-44 -26 328 486" role="img" aria-label={summary}>
    <g class="figure" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="120" cy="52" r="26"></circle>
      <path d="M120 78 V96"></path>
      <path d="M78 108 Q120 92 162 108 Q168 170 154 232 H86 Q72 170 78 108 Z"></path>
      <path d="M76 114 Q52 172 46 250"></path>
      <path d="M164 114 Q188 172 194 250"></path>
      <path d="M98 232 L92 420"></path>
      <path d="M142 232 L148 420"></path>
    </g>
    {
      points.map((p) => (
        <g class:list={['point', p.dir]} style={`--i: ${p.n - 1}`}>
          {p.whole && <ellipse class="link" cx="120" cy="226" rx="98" ry="214" />}
          {p.ground && <line class="link" x1="40" y1="428" x2="236" y2="428" />}
          {p.anchor && <line class="link" x1={p.x} y1={p.y} x2={p.anchor[0]} y2={p.anchor[1]} />}
          <circle class="ping" cx={p.x} cy={p.y} r="9" fill="none" stroke-width="1.5" />
          <circle class="dot" cx={p.x} cy={p.y} r="9" />
          <text x={p.x} y={p.y + 3.5} text-anchor="middle">{p.n}</text>
        </g>
      ))
    }
  </svg>
  <div class="contacts">
    <ol>
      {
        points.map((p) => (
          <li class={p.dir}>
            <span class="n" aria-hidden="true">{p.n}</span>
            <span>
              <span class="kind">{p.dir === 'in' ? 'BODY → MACHINE' : 'MACHINE → BODY'}</span>
              <span class="what">{p.label}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <p class="legend"><span class="pink">●</span> body → machine &nbsp;&nbsp; <span class="cyan">●</span> machine → body</p>
  </div>
</div>

<style>
  .body-map {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }

  svg {
    flex: 0 0 auto;
    display: block;
    width: 300px;
    max-width: 78%;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .figure {
    stroke: var(--border-strong);
  }

  .point {
    --col: var(--cyan);
    fill: var(--col);
    stroke: var(--col);
    animation: point-in 500ms var(--ease) both;
    animation-delay: calc(var(--i) * 180ms + 200ms);
  }

  .point.in {
    --col: var(--pink);
  }

  .point .dot {
    stroke: none;
  }

  /* The ring around the whole body, and the dotted line from an outside point. */
  .point .link {
    fill: none;
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    stroke-linecap: round;
    opacity: 0.7;
  }

  .point .ping {
    animation-delay: calc(var(--i) * 0.7s);
  }

  .point text {
    fill: var(--accent-foreground);
    stroke: none;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
  }

  @keyframes point-in {
    from {
      opacity: 0;
    }
  }

  .contacts {
    flex: 1 1 320px;
    min-width: 0;
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    --col: var(--cyan);
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  li.in {
    --col: var(--pink);
  }

  .n {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--col);
    color: var(--accent-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .kind {
    display: block;
    margin-bottom: 4px;
    color: var(--col);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .what {
    display: block;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .legend {
    margin: 24px 0 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
</style>
