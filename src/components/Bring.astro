---
// "What I bring": three columns of skills in one box, and the human–robot loop
// underneath. The text itself lives in BRING and LOOP in src/site.config.ts.
import { BRING, LOOP } from '../site.config';
---

  <section class="band band-alt" id="stack" aria-labelledby="stack-heading">
    <div class="container section">
      <div class="section-intro reveal">
        <p class="kicker">WHAT I BRING</p>
        <h2 class="display" id="stack-heading">Mechanism, embodiment, intelligence.</h2>
      </div>
      <div class="bring">
        {
          BRING.map((column) => (
            <div class:list={['bring-card', 'reveal', column.kind]}>
              <p class="bring-label">{column.label}</p>
              <h3>{column.title}</h3>
              <ul>
                {column.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
      <ol class="loop" aria-label="The human–robot loop">
        {
          LOOP.map((step, i) => (
            <li class:list={['node', step.kind]} style={`animation-delay: ${i * 1.5}s`}>
              <span class="node-label">{step.label}</span>
              <span class="node-text">{step.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: var(--space-xl);
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  /* ---------- What I bring ---------- */
  /* One box at every width: mechanics, human and intelligence side by side,
     split by single lines — it never wraps into separate cards. */
  .bring {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  .bring-card {
    --col: var(--cyan);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px;
  }

  .bring-card + .bring-card {
    border-left: 1px solid var(--border);
  }

  .bring-card.human {
    --col: var(--pink);
  }

  .bring-card.mind {
    --col: var(--foreground);
  }

  .bring-label {
    margin: 0;
    color: var(--col);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .bring-card h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .bring-card ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding-left: 18px;
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* The loop: each step lights up in turn, then the cycle repeats. */
  .loop {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    animation: pulse-node 6s linear infinite;
  }

  @keyframes pulse-node {
    0%,
    20% {
      border-color: var(--border);
      box-shadow: none;
    }

    5%,
    15% {
      border-color: var(--pink);
      box-shadow: 0 0 28px rgb(255 111 181 / 0.22);
    }
  }

  .node-label {
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .node.human .node-label {
    color: var(--pink);
  }

  .node-text {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .section {
      gap: 24px;
      padding-block: 44px;
    }

    .display {
      font-size: 1.5rem;
    }

    /* What I bring: still three columns in one box, at a smaller scale */
    .bring {
      border-radius: 14px;
    }

    .bring-card {
      gap: 6px;
      padding: 10px 8px;
    }

    .bring-label {
      font-size: 0.5rem;
    }

    .bring-card h3 {
      font-size: 0.75rem;
      line-height: 1.25;
    }

    .bring-card ul {
      gap: 5px;
      padding-left: 10px;
      font-size: 0.625rem;
      line-height: 1.35;
    }

    .loop {
      gap: 4px;
    }

    .node {
      gap: 2px;
      padding: 6px;
      border-radius: 8px;
    }

    .node-label {
      font-size: 0.5rem;
    }

    .node-text {
      font-size: 0.625rem;
      line-height: 1.3;
    }
  }
</style>
