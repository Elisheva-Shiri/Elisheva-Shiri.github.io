---
// Quick view: a pop-up with a project's cover, one-line summary and the two
// lenses, and one button that leads to the full project page.
// Any element with data-open="<project id>" opens it. Those elements are normal
// links to the project page, so everything still works without JavaScript.
// Previous / Next walk through the cards currently visible on the page.
// Keyboard: ←/→ change project, Esc closes.
import { popupData, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
}

const data = Object.fromEntries(Astro.props.projects.map((project) => [project.id, popupData(project)]));
---

<dialog class="popup" data-popup aria-labelledby="popup-title">
  <div class="popup-panel" data-panel>
    <div class="popup-media">
      <img data-img alt="" hidden />
      <div class="placeholder" data-blank hidden></div>
    </div>
    <div class="popup-info">
      <div class="popup-bar">
        <span class="popup-label" data-label></span>
        <button type="button" class="popup-close" data-close aria-label="Close">✕</button>
      </div>
      <h2 id="popup-title" data-title></h2>
      <p class="popup-meta" data-meta></p>
      <p class="popup-short" data-short></p>
      <div class="lens" data-mechanics>
        <span class="lens-label">◆ MECHANICS</span>
        <p></p>
      </div>
      <div class="lens lens-human" data-human>
        <span class="lens-label">● HUMAN</span>
        <p></p>
      </div>
      <div class="popup-spacer"></div>
      <a class="popup-full" data-link>See the full project →</a>
      <div class="popup-nav" data-nav>
        <button type="button" data-prev>← Previous</button>
        <button type="button" data-next>Next →</button>
      </div>
    </div>
  </div>
</dialog>

<script type="application/json" id="popup-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  import type { PopupProject } from '../lib/projects';

  const dialog = document.querySelector<HTMLDialogElement>('[data-popup]');
  const source = document.getElementById('popup-data');

  if (dialog && source) {
    const projects: Record<string, PopupProject> = JSON.parse(source.textContent ?? '{}');
    const $ = <T extends HTMLElement>(name: string) => dialog.querySelector<T>(`[data-${name}]`)!;
    const panel = $('panel');
    const image = $<HTMLImageElement>('img');
    const blank = $('blank');

    let sequence: string[] = [];
    let current: PopupProject | undefined;
    let opener: HTMLElement | null = null;

    const show = (slug: string) => {
      const project = projects[slug];
      if (!project) return;
      current = project;
      panel.style.setProperty('--col', project.color);
      blank.style.setProperty('--col', project.color);
      image.hidden = !project.image;
      blank.hidden = Boolean(project.image);
      if (project.image) {
        image.src = project.image;
        image.alt = project.title;
      } else {
        blank.textContent = project.initials;
      }
      $('label').textContent = project.label;
      $('title').textContent = project.title;
      const position = sequence.length > 1 ? `${sequence.indexOf(slug) + 1} / ${sequence.length}` : '';
      $('meta').textContent = [project.year, position].filter(Boolean).join(' · ');
      $('short').textContent = project.short;
      for (const lens of ['mechanics', 'human'] as const) {
        const box = $(lens);
        box.hidden = !project[lens];
        box.querySelector('p')!.textContent = project[lens] ?? '';
      }
      $<HTMLAnchorElement>('link').href = project.url;
      $('nav').hidden = sequence.length < 2;
      panel.scrollTop = 0;
      // Restart the short "content changed" animation.
      panel.classList.remove('popup-swap');
      void panel.offsetWidth;
      panel.classList.add('popup-swap');
    };

    const move = (step: number) => {
      if (!current || sequence.length < 2) return;
      const index = sequence.indexOf(current.slug);
      show(sequence[(index + step + sequence.length) % sequence.length]);
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-open]');
      // Let ctrl/⌘/shift/middle clicks open the project page as a normal link.
      if (!trigger || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const slug = trigger.dataset.open!;
      if (!projects[slug]) return;
      event.preventDefault();
      const visible = [...document.querySelectorAll<HTMLElement>('[data-open]')].filter((el) => el.offsetParent !== null);
      sequence = [...new Set(visible.map((el) => el.dataset.open!))];
      if (!sequence.includes(slug)) sequence = [slug];
      opener = trigger;
      show(slug);
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      $('link').focus({ preventScroll: true });
    });

    $('close').addEventListener('click', () => dialog.close());
    $('prev').addEventListener('click', () => move(-1));
    $('next').addEventListener('click', () => move(1));

    // Clicking the dark backdrop (outside the panel) closes the pop-up.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus({ preventScroll: true });
    });
  }
</script>

<style is:global>
  .popup {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 24px;
    border: 0;
    background: var(--overlay);
    color: var(--foreground);
    cursor: zoom-out;
  }

  .popup[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: popup-fade 200ms ease both;
  }

  .popup::backdrop {
    background: transparent;
  }

  .popup-panel {
    --col: var(--cyan);
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width: 1080px;
    max-height: 100%;
    overflow: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    cursor: auto;
    animation: popup-in 320ms var(--ease) both;
  }

  @keyframes popup-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes popup-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  @keyframes popup-swap {
    from {
      opacity: 0.35;
    }
  }

  .popup-swap .popup-media,
  .popup-swap .popup-info > :not(.popup-bar, .popup-nav) {
    animation: popup-swap 260ms ease both;
  }

  .popup-media {
    flex: 999 1 480px;
    align-self: center;
    min-width: 0;
    padding: 16px;
  }

  /* The whole image, uncropped: diagrams and screenshots must stay readable. */
  .popup-media img,
  .popup-media .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--surface-2);
    object-fit: contain;
  }

  .popup-media .placeholder {
    height: auto;
    font-size: 4rem;
  }

  .popup-info {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px 28px 24px;
  }

  .popup-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .popup-label {
    color: var(--col);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .popup-close {
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    font-size: 1.125rem;
    cursor: pointer;
    transition: border-color var(--transition), transform var(--transition);
  }

  .popup-close:hover {
    border-color: var(--foreground);
    transform: rotate(90deg);
  }

  .popup h2 {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.18;
  }

  .popup-meta {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .popup-short {
    margin: 0;
    color: var(--text);
    line-height: 1.6;
  }

  .popup-info .lens {
    gap: 6px;
    padding: 14px;
    border-radius: 12px;
  }

  .popup-info .lens p {
    font-size: 0.875rem;
  }

  .popup-spacer {
    flex-grow: 1;
  }

  .popup-full {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--col);
    color: var(--accent-foreground);
    font-weight: 700;
    transition: background var(--transition), transform var(--transition);
  }

  .popup-full:hover {
    background: var(--foreground);
    color: var(--accent-foreground);
    transform: translateY(-1px);
  }

  .popup-nav {
    display: flex;
    gap: 10px;
  }

  .popup-nav button {
    flex: 1 1 0;
    min-height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--transition);
  }

  .popup-nav button:hover {
    border-color: var(--foreground);
  }

  @media (max-width: 40rem) {
    .popup {
      padding: 10px;
    }

    .popup-info {
      gap: 16px;
      padding: 18px;
    }

    /* A smaller picture, so the text gets the room */
    .popup-media {
      padding: 10px 10px 0;
    }

    .popup-media img,
    .popup-media .placeholder {
      max-height: 170px;
    }

    .popup h2 {
      font-size: 1.375rem;
    }

    .popup-meta {
      font-size: 0.8125rem;
    }

    .popup-short {
      font-size: 1.125rem;
      line-height: 1.55;
    }

    .popup-info .lens p {
      font-size: 1.0625rem;
      line-height: 1.55;
    }

    .popup-info .lens-label {
      font-size: 0.75rem;
    }
  }
</style>
