---
// Homepage header: the name over a live "oscilloscope" of signal traces.
// Moving the pointer (or a finger) bends the waves near it. The canvas is
// decorative: without JavaScript, or with reduced motion, the text stands alone
// over a still drawing.
import { SITE } from '../site.config';

interface Props {
  stats: { label: string; value: string }[];
}

const { stats } = Astro.props;
---

<section class="hero" data-hero>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <p class="label hero-role">{SITE.role}</p>
    <h1 class="hero-name">
      {SITE.name.split(' ').map((word) => <span>{word}</span>)}
    </h1>
    {SITE.intro && <p class="hero-intro">{SITE.intro}</p>}
    <dl class="hero-stats">
      {
        stats.map((stat) => (
          <div>
            <dt class="label">{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
    <a class="hero-scroll label" href="#index">Explore the work ↓</a>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (hero && canvas && ctx) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = { x: -9999, y: -9999, tx: -9999, ty: -9999, energy: 0 };
    let width = 0;
    let height = 0;
    let visible = true;
    let frame = 0;

    const colours = () => {
      const style = getComputedStyle(document.documentElement);
      return { line: style.getPropertyValue('--faint').trim(), accent: style.getPropertyValue('--accent').trim() };
    };
    let palette = colours();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => (palette = colours()));

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = hero.clientWidth;
      height = hero.clientHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, width, height);
      // Ease the pointer so the bend follows smoothly.
      pointer.x += (pointer.tx - pointer.x) * 0.12;
      pointer.y += (pointer.ty - pointer.y) * 0.12;
      pointer.energy *= 0.97;

      const lines = Math.max(14, Math.round(height / 34));
      const gap = height / (lines + 1);
      for (let i = 1; i <= lines; i++) {
        const baseY = i * gap;
        const near = Math.exp(-((baseY - pointer.y) ** 2) / (2 * 90 ** 2));
        ctx.beginPath();
        for (let x = 0; x <= width; x += 6) {
          const dx = x - pointer.x;
          const bump = Math.exp(-(dx * dx) / (2 * 140 ** 2)) * near;
          const amp = 2 + bump * (36 + pointer.energy * 30);
          const freq = 0.012 + i * 0.0009 + bump * 0.02;
          const y = baseY + Math.sin(x * freq + t * 0.0012 * (1 + i * 0.05) + i) * amp;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        const hot = near > 0.35 && pointer.x > -999;
        ctx.strokeStyle = hot ? palette.accent : palette.line;
        ctx.globalAlpha = hot ? 0.9 : 0.45;
        ctx.lineWidth = hot ? 1.4 : 1;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    };

    const loop = (t: number) => {
      if (visible) draw(t);
      frame = requestAnimationFrame(loop);
    };

    const move = (x: number, y: number) => {
      const rect = hero.getBoundingClientRect();
      const nx = x - rect.left;
      const ny = y - rect.top;
      pointer.energy = Math.min(1, pointer.energy + Math.hypot(nx - pointer.tx, ny - pointer.ty) / 400);
      pointer.tx = nx;
      pointer.ty = ny;
    };

    resize();
    window.addEventListener('resize', () => {
      resize();
      if (reducedMotion) draw(0);
    });

    if (reducedMotion) {
      draw(0);
    } else {
      hero.addEventListener('pointermove', (e) => move(e.clientX, e.clientY));
      hero.addEventListener('pointerleave', () => ((pointer.tx = -9999), (pointer.ty = -9999)));
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(hero);
      frame = requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(88vh, 54rem);
    padding-block: var(--space-xl) var(--space-lg);
    pointer-events: none;
  }

  .hero-inner a {
    pointer-events: auto;
  }

  .hero-role {
    margin: 0 0 var(--space-md);
    color: var(--accent);
  }

  .hero-name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.22em;
    margin: 0;
    font-size: var(--font-size-display);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .hero-name span {
    display: inline-block;
    animation: rise 900ms var(--ease) both;
  }

  .hero-name span:nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-name span:nth-child(3) {
    animation-delay: 160ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }
  }

  .hero-intro {
    max-width: 30rem;
    margin: var(--space-lg) 0 0;
    font-size: var(--font-size-lg);
    line-height: 1.35;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .hero-stats div {
    margin: 0;
  }

  .hero-stats dd {
    margin: var(--space-xs) 0 0;
    font-size: var(--font-size-lg);
    font-variant-numeric: tabular-nums;
  }

  .hero-scroll {
    align-self: flex-start;
    margin-top: var(--space-lg);
    color: var(--foreground);
    text-decoration: none;
  }

  .hero-scroll:hover {
    color: var(--accent);
  }
</style>
