---
// Responsive gallery of images and videos, with a lightbox.
// Each item can have a short caption (shown under it) and keywords (shown on
// hover; always visible on touch screens). Videos (.mp4/.webm) play as silent
// loops while on screen, unless the visitor prefers reduced motion.
// Each thumbnail is a normal link to the full file, so it still works without
// JavaScript. With JavaScript, it opens in a <dialog> with previous/next controls.
// Keyboard: Enter opens, ←/→ navigate, Esc closes. Touch: swipe left/right.
import { withBase } from '../lib/projects';

type Item = string | { src: string; alt?: string; caption?: string; keywords?: string[]; poster?: string };

interface Props {
  items: Item[];
  title: string;
}

const { items: input, title } = Astro.props;
const items = input.map((item, i) => {
  const { src, alt, caption, keywords = [], poster } = typeof item === 'string' ? { src: item } : item;
  return {
    src: withBase(src),
    alt: alt ?? `${title} — item ${i + 1}`,
    caption,
    keywords,
    poster: poster && withBase(poster),
    isVideo: /\.(mp4|webm)$/i.test(src),
  };
});
---

<div class="gallery" data-gallery>
  <ul class="gallery-grid">
    {
      items.map((item, i) => (
        <li>
          <figure>
            <a
              href={item.src}
              data-gallery-item={i}
              data-video={item.isVideo ? '' : undefined}
              data-alt={item.alt}
              data-caption={item.caption}
              data-poster={item.poster}
              aria-label={`Open ${item.isVideo ? 'video' : 'image'} ${i + 1} of ${items.length}: ${item.alt}`}
            >
              {item.isVideo ? (
                <video src={item.src} poster={item.poster} muted loop playsinline preload="metadata" aria-hidden="true" />
              ) : (
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              )}
              {item.keywords.length > 0 && <span class="gallery-keywords">{item.keywords.join(' · ')}</span>}
            </a>
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Media viewer">
    <figure class="lightbox-figure">
      <img alt="" />
      <video controls muted loop playsinline hidden></video>
      <figcaption>
        <span data-caption></span>
        <span class="lightbox-counter" data-counter></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox-button lightbox-close" data-close aria-label="Close">✕</button>
    {
      items.length > 1 && (
        <>
          <button type="button" class="lightbox-button lightbox-prev" data-prev aria-label="Previous">‹</button>
          <button type="button" class="lightbox-button lightbox-next" data-next aria-label="Next">›</button>
        </>
      )
    }
  </dialog>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]')];
    const dialog = gallery.querySelector('dialog')!;
    const image = dialog.querySelector('img')!;
    const video = dialog.querySelector('video')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    let index = 0;

    // Thumbnail videos play only while visible.
    if (!reducedMotion) {
      const observer = new IntersectionObserver((entries) => {
        for (const { target, isIntersecting } of entries) {
          const clip = target as HTMLVideoElement;
          isIntersecting ? clip.play().catch(() => {}) : clip.pause();
        }
      });
      gallery.querySelectorAll('.gallery-grid video').forEach((clip) => observer.observe(clip));
    }

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      const isVideo = link.hasAttribute('data-video');
      image.hidden = isVideo;
      video.hidden = !isVideo;
      if (isVideo) {
        video.src = link.href;
        video.poster = link.dataset.poster ?? '';
        video.setAttribute('aria-label', link.dataset.alt ?? '');
        if (!reducedMotion) video.play().catch(() => {});
      } else {
        video.pause();
        video.removeAttribute('src');
        image.src = link.href;
        image.alt = link.dataset.alt ?? '';
      }
      caption.textContent = link.dataset.caption ?? '';
      counter.textContent = links.length > 1 ? `${index + 1} / ${links.length}` : '';
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));

    // Clicking the dark backdrop (outside the media and buttons) closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === dialog.querySelector('figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    // Swipe on touch screens.
    let startX: number | null = null;
    dialog.addEventListener('touchstart', (event) => (startX = event.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      if (startX === null) return;
      const distance = event.changedTouches[0].clientX - startX;
      if (Math.abs(distance) > 50) show(distance < 0 ? index + 1 : index - 1);
      startX = null;
    });

    // Stop the video and return keyboard focus to the thumbnail that was last shown.
    dialog.addEventListener('close', () => {
      video.pause();
      links[index].focus();
    });
  }
</script>

<style>
  .gallery-grid {
    columns: 3 16rem;
    column-gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-grid li {
    break-inside: avoid;
    margin-bottom: var(--space-lg);
  }

  figure {
    margin: 0;
  }

  .gallery-grid a {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--placeholder);
    color: inherit;
    text-decoration: none;
    cursor: zoom-in;
  }

  .gallery-grid img,
  .gallery-grid video {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery-keywords {
    display: block;
    padding: var(--space-sm) var(--space-md);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  /* Devices that can hover: keywords appear over the image on hover/focus */
  @media (hover: hover) and (pointer: fine) {
    .gallery-keywords {
      position: absolute;
      inset: auto 0 0 0;
      padding: var(--space-lg) var(--space-md) var(--space-md);
      background: linear-gradient(transparent, var(--overlay));
      color: #fff;
      opacity: 0;
      transition: opacity var(--transition);
    }

    .gallery-grid a:hover .gallery-keywords,
    .gallery-grid a:focus-visible .gallery-keywords {
      opacity: 1;
    }
  }

  .gallery-grid figcaption {
    margin-top: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--muted);
    line-height: 1.5;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.92);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    height: 100%;
    padding: var(--space-xl) var(--space-xl) var(--space-md);
  }

  .lightbox-figure img,
  .lightbox-figure video {
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    object-fit: contain;
  }

  .lightbox-figure [hidden] {
    display: none;
  }

  .lightbox-figure figcaption {
    display: flex;
    gap: var(--space-md);
    max-width: var(--text-width);
    font-size: var(--font-size-sm);
    color: rgb(255 255 255 / 0.85);
    text-align: center;
  }

  .lightbox-button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-button:hover {
    background: rgb(255 255 255 / 0.25);
  }

  .lightbox-button:focus-visible {
    outline-color: #fff;
  }

  .lightbox-close {
    top: var(--space-md);
    right: var(--space-md);
    font-size: 1.25rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev {
    left: var(--space-md);
  }

  .lightbox-next {
    right: var(--space-md);
  }

  @media (max-width: 40rem) {
    .lightbox-figure {
      padding: 4.5rem var(--space-sm) 5rem;
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: var(--space-md);
      transform: none;
    }
  }
</style>
