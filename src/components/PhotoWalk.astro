---
// An immersive gallery: a full-screen walk through a project's images.
// Each image fills the window and stays in place while the next one slides over
// it; a blurred copy of the image lights the space around it. An item's `group`
// starts a new series with a title screen. Pure CSS: it works without JavaScript.
import { withBase } from '../lib/projects';

type Item = string | { src: string; alt?: string; caption?: string; group?: string };

interface Props {
  items: Item[];
  title: string;
}

const { title } = Astro.props;
const items = Astro.props.items
  .map((item) => (typeof item === 'string' ? { src: item } : item))
  .filter((item) => !/\.(mp4|webm)$/i.test(item.src));
const groups = [...new Set(items.map((item) => item.group).filter(Boolean))];
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="walk">
  {
    items.map((item, i) => {
      const opens = item.group && item.group !== items[i - 1]?.group;
      const src = withBase(item.src);
      return (
        <>
          {opens && (
            <div class="walk-screen walk-title">
              <p class="kicker kicker-pink">
                SERIES {pad(groups.indexOf(item.group) + 1)} / {pad(groups.length)}
              </p>
              <h3>{item.group}</h3>
            </div>
          )}
          <figure class="walk-screen">
            <img class="walk-glow" src={src} alt="" aria-hidden="true" loading="lazy" decoding="async" />
            <img class="walk-photo" src={src} alt={item.alt ?? `${title} — image ${i + 1}`} loading="lazy" decoding="async" />
            <figcaption>
              <span>{item.caption}</span>
              <span class="walk-count">
                {pad(i + 1)} / {pad(items.length)}
              </span>
            </figcaption>
          </figure>
        </>
      );
    })
  }
</div>

<style>
  /* Breaks out of the page column to the full width of the window. */
  .walk {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .walk-screen {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    height: 100svh;
    margin: 0;
    overflow: hidden;
    background: var(--background);
    box-shadow: 0 -24px 60px rgb(0 0 0 / 0.6);
  }

  .walk-title {
    gap: 16px;
    text-align: center;
  }

  .walk-title h3 {
    margin: 0;
    font-size: clamp(2.5rem, 9vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .walk-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(48px) brightness(0.45) saturate(1.2);
    transform: scale(1.25);
  }

  .walk-photo {
    position: relative;
    max-width: min(100% - 48px, 1400px);
    max-height: calc(100% - 140px);
    border-radius: var(--radius);
    object-fit: contain;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55);
  }

  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 24px;
    color: var(--foreground);
    font-size: 0.9375rem;
  }

  .walk-count {
    flex: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* Each screen settles into place as it arrives. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .walk-photo,
      .walk-title h3 {
        animation: arrive linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 100%;
      }

      @keyframes arrive {
        from {
          opacity: 0.2;
          transform: scale(0.9);
        }
      }
    }
  }
</style>
