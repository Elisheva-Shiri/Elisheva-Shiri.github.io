---
// The live lab at the top of the homepage: two linked simulations drawn in SVG.
// - A dexterous hand that pre-shapes and closes as the pointer approaches, and
//   opens to yield when the pointer moves abruptly.
// - A headset view of a remote cell. Moving the pointer turns the head; looking
//   at the cube selects it, and the hand on the left closes to pick it up.
// Left alone, both run an idle demo. Without JavaScript the still drawing stays.
const fingers = ['Thumb', 'Index', 'Middle', 'Ring', 'Pinky'];
const grasps = [
  { id: 'power', label: 'Power' },
  { id: 'pinch', label: 'Pinch' },
  { id: 'point', label: 'Point' },
];
---

<section class="lab container" id="lab" aria-label="Interactive lab" data-lab>
  <div class="lab-grid">
    <div class="panel">
      <div class="panel-head">
        <p class="panel-title">DEXTEROUS HAND · 15 JOINTS · <span data-k="hMode" data-state="idle">IDLE DEMO</span></p>
        <div class="segmented" role="group" aria-label="Grasp type">
          {grasps.map((g, i) => <button class="pill" type="button" data-grasp={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>)}
        </div>
      </div>
      <div class="stage stage-hand" data-stage="hand">
        <svg viewBox="0 0 400 440" role="img" aria-label="Robotic hand that pre-shapes and grasps as your pointer approaches, and opens to yield when you move abruptly. Tap a finger to pinch it against the thumb.">
          <rect class="chassis" x="150" y="380" width="96" height="60" rx="10" fill="#171312" stroke="#473D38" stroke-width="1.5"></rect>
          <line class="slot" x1="170" y1="392" x2="170" y2="440" stroke="#241E1C" stroke-width="2"></line>
          <line class="slot" x1="198" y1="392" x2="198" y2="440" stroke="#241E1C" stroke-width="2"></line>
          <line class="slot" x1="226" y1="392" x2="226" y2="440" stroke="#241E1C" stroke-width="2"></line>
          <rect class="chassis" x="116" y="236" width="164" height="156" rx="34" fill="#171312" stroke="#473D38" stroke-width="1.5"></rect>
          <g class="contact" fill="#F90F00" opacity="0" data-k="contact">
            <circle cx="168" cy="300" r="5"></circle>
            <circle cx="198" cy="290" r="5"></circle>
            <circle cx="228" cy="300" r="5"></circle>
            <circle cx="183" cy="330" r="5"></circle>
            <circle cx="213" cy="330" r="5"></circle>
            <circle cx="198" cy="358" r="5"></circle>
          </g>
          <g class="casings" fill="none" stroke="#2F2825" stroke-linecap="round" stroke-linejoin="round">
            <path class="finger" data-k="f0" data-finger="0" stroke-width="22" d="M 140 252 L 140 203 L 140 172 L 140 149"></path>
            <path class="finger" data-k="f1" data-finger="1" stroke-width="23" d="M 178 252 L 178 197 L 178 162 L 178 137"></path>
            <path class="finger" data-k="f2" data-finger="2" stroke-width="22" d="M 216 252 L 216 201 L 216 169 L 216 146"></path>
            <path class="finger" data-k="f3" data-finger="3" stroke-width="19" d="M 254 252 L 254 213 L 254 188 L 254 169"></path>
            <path data-k="f4" stroke-width="24" d="M 124 346 L 100.6 316.1 L 82.1 292.5 L 67.3 273.6"></path>
          </g>
          <path class="tendons" data-k="tendons" fill="none" stroke="#679365" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity=".9"></path>
          <path class="joints" data-k="joints" fill="none" stroke="#679365" stroke-width="8" stroke-linecap="round"></path>
          <path class="tips" data-k="tips" fill="none" stroke="#F90F00" stroke-width="9" stroke-linecap="round"></path>
          <g data-k="cursor" opacity="0">
            <circle class="ping cursor-ring" data-k="cursorDot" cx="200" cy="200" r="6" fill="none" stroke="#F90F00" stroke-width="1.5"></circle>
            <circle class="cursor-dot" data-k="cursorDot" cx="200" cy="200" r="3" fill="#F90F00"></circle>
          </g>
        </svg>
      </div>
      <div class="flex-bars">
        {
          fingers.map((name, i) => (
            <div class="flex-bar">
              <span class="flex-name"><span>{name}</span> <span><span data-k={`deg${i}`}>0</span>°</span></span>
              <div class="track"><div class:list={['fill', { thumb: i === 0 }]} data-k={`bar${i}`}></div></div>
            </div>
          ))
        }
      </div>
      <dl class="foot">
        <div><dt>GRIP FORCE</dt><dd class="pink"><span data-k="gripN">0</span> N</dd></div>
        <div><dt>TENDON (IDX)</dt><dd><span data-k="tendonN">1.5</span> N</dd></div>
        <div class="wide"><dt class="cyan">ROBOT RESPONSE</dt><dd data-k="robotResp">Open, waiting</dd></div>
      </dl>
    </div>

    <div class="panel">
      <div class="panel-head">
        <p class="panel-title">MIXED-REALITY · HEADSET VIEW · <span data-k="xrMode" data-state="idle">IDLE DEMO</span></p>
        <p class="panel-title">90 Hz · stereo</p>
      </div>
      <div class="stage stage-xr" data-stage="xr">
        <svg viewBox="0 0 400 440" role="img" aria-label="Headset view of a virtual teleoperation scene. Move your pointer to turn your head; looking at the grasp target selects it and triggers a fingertip haptic cue">
          <rect class="sky" width="400" height="440" fill="#0D0A09"></rect>
          <path class="floor" data-k="xrGrid" fill="none" stroke="#3C5A3B" stroke-width="1"></path>
          <circle class="landmark soft" data-k="ring" data-state="dashed" fill="none" stroke="#C05A08" stroke-width="2"></circle>
          <circle class="landmark" data-k="sphere" data-state="outline" fill="none" stroke="#F76E02" stroke-width="1.5"></circle>
          <path class="cube-faces" data-k="cubeFaces" fill="#679365" fill-opacity="0" stroke="none"></path>
          <path class="cube-edges" data-k="cubeEdges" fill="none" stroke="#679365" stroke-width="2" stroke-linejoin="round"></path>
          <line class="proxy-stroke" data-k="proxyLine" stroke="#679365" stroke-width="1" stroke-dasharray="2 4" opacity="0"></line>
          <circle class="proxy-fill" data-k="proxyHalo" fill="#679365" opacity=".14"></circle>
          <circle class="ping proxy-stroke" data-k="proxyPing" cx="-50" cy="-50" r="6" fill="none" stroke="#679365" stroke-width="1.2"></circle>
          <circle class="proxy-fill" data-k="proxyDot" fill="#679365"></circle>
          <text class="hud cyan-text" data-k="linkLabel" x="364" y="44" text-anchor="end" fill="#679365">HAND PROXY · HOVERING</text>
          <text class="hud hud-lg cube-label" data-k="cubeLabel" fill="#679365"></text>
          <path class="frame" d="M 24 60 V 24 H 60 M 340 24 H 376 V 60 M 376 380 V 416 H 340 M 60 416 H 24 V 380" fill="none" stroke="#473D38" stroke-width="2"></path>
          <circle class="reticle" data-k="reticle" cx="200" cy="220" r="10" fill="none" stroke="#F6F1EE" stroke-width="2"></circle>
          <circle class="reticle-dot" data-k="reticleDot" cx="200" cy="220" r="2.5" fill="#F6F1EE"></circle>
          <circle class="ping pink-stroke" data-k="reticlePing" cx="200" cy="220" r="6" fill="none" stroke="#F90F00" stroke-width="1.5" opacity="0"></circle>
          <text class="hud dim-text" x="36" y="44" fill="#978B83">REMOTE CELL · CAM 01</text>
          <text class="hud dim-text" data-k="hudHaptic" x="364" y="404" text-anchor="end" fill="#978B83">HAPTIC IDLE</text>
        </svg>
      </div>
      <dl class="readout">
        <div><dt>HEAD YAW</dt><dd><span data-k="yawDeg">0</span>°</dd></div>
        <div><dt>PITCH</dt><dd><span data-k="pitchDeg">0</span>°</dd></div>
        <div><dt>MOTION→PHOTON</dt><dd><span data-k="m2p">17.6</span> ms</dd></div>
        <div><dt>SKIN STRETCH</dt><dd class="pink"><span data-k="hapMm">0.0</span> mm</dd></div>
      </dl>
      <dl class="dialogue">
        <div><dt class="pink">OPERATOR GAZE</dt><dd data-k="gazeState">Scanning the scene</dd></div>
        <div><dt class="cyan">SYSTEM FEEDBACK</dt><dd data-k="xrResp">Reticle free · no cue</dd></div>
      </dl>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-lab]');

  if (root) {
    // ---- DOM writes, skipped when the value did not change ----
    const nodes = new Map<string, Element[]>();
    for (const el of root.querySelectorAll('[data-k]')) {
      const key = el.getAttribute('data-k')!;
      nodes.set(key, [...(nodes.get(key) ?? []), el]);
    }
    const last = new Map<string, string>();
    const write = (key: string, slot: string, value: string | number, apply: (el: Element, v: string) => void) => {
      const v = String(value);
      const id = key + '|' + slot;
      if (last.get(id) === v) return;
      last.set(id, v);
      for (const el of nodes.get(key) ?? []) apply(el, v);
    };
    const attr = (key: string, name: string, value: string | number) => write(key, name, value, (el, v) => el.setAttribute(name, v));
    const text = (key: string, value: string | number) => write(key, '#text', value, (el, v) => (el.textContent = v));
    const flag = (key: string, name: string, on: boolean) => write(key, name, on ? '1' : '0', (el, v) => el.classList.toggle(name, v === '1'));
    const width = (key: string, percent: number) => write(key, 'width', percent, (el, v) => ((el as HTMLElement).style.width = v + '%'));

    // ---- State ----
    type Grasp = 'power' | 'pinch' | 'point';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const s = {
      t: 0,
      g: 0.3, // how closed the hand is, 0–1
      hx: 200,
      hy: 200,
      lastHand: 0,
      startleUntil: 0,
      prevMove: null as { x: number; y: number; t: number } | null,
      mode: 'power' as Grasp,
      pinch: 0, // which finger the thumb pinches against: 0 index … 3 pinky
      yaw: 0,
      pitch: 0,
      yawT: 0,
      pitchT: 0,
      lastXr: 0,
      gazeHold: 0,
      aim: '' as '' | 'ring' | 'sphere' | 'cube', // what the reticle is resting on
      lastAim: '' as '' | 'ring' | 'sphere' | 'cube',
      aimAt: 0,
      noise: [0.5, 0.5, 0.5],
      noiseAt: 0,
    };

    const D = Math.PI / 180;
    const FL = 260; // focal length of the headset view
    const NEAR = 0.35;
    const IDLE_AFTER = 2500;
    const r = (v: number) => Math.round(v * 10) / 10;
    const clamp = (v: number) => Math.max(0, Math.min(1, v));
    const MULT: Record<Grasp, number[]> = { power: [1, 1, 1, 1, 1], pinch: [0.85, 0.6, 0.12, 0.1, 0.1], point: [0.9, 0.03, 1, 1, 1] };
    // Pinch: the thumb meets one finger while the others stay out of the way.
    // The thumb reaches a little further for the fingers further along the hand.
    const PINCH_FINGERS = ['index', 'middle', 'ring', 'pinky'];
    const pinchMult = (pick: number) => [0.8 + pick * 0.07, ...PINCH_FINGERS.map((_, i) => (i === pick ? 0.62 : 0.1))];
    const FMAX: Record<Grasp, number> = { power: 22, pinch: 9, point: 4 };
    const FINGERS = [
      { bx: 140, L: [50, 31, 23] },
      { bx: 178, L: [56, 35, 25] },
      { bx: 216, L: [52, 32, 23] },
      { bx: 254, L: [40, 25, 19] },
    ];
    const KNUCKLE_Y = 252;
    const thumbSeq = (g: number) => clamp((g - 0.4) / 0.6);
    const liftOf = (g: number) => Math.max(0, (thumbSeq(g) - 0.6) / 0.4);
    // The grasp target in the remote cell rises as the hand closes around it.
    const cubeCentre = (lift: number) => [-0.5, -0.35 + lift * 0.45, 3 - lift * 0.5];
    const project = (x: number, y: number, z: number) => {
      const cy = Math.cos(s.yaw), sy = Math.sin(s.yaw), cp = Math.cos(s.pitch), sp = Math.sin(s.pitch);
      const x1 = x * cy - z * sy, z1 = x * sy + z * cy;
      const y1 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
      return { x: 200 + (FL * x1) / z2, y: 220 - (FL * y1) / z2, z: z2 };
    };

    // ---- Simulation step. `k` is elapsed time in 40 ms units, so speed is frame-rate independent. ----
    const step = (k: number, now: number) => {
      const ease = (rate: number) => 1 - Math.pow(1 - rate, k);
      s.t += 0.04 * k;

      const c = cubeCentre(liftOf(s.g));
      const p = project(c[0], c[1], c[2]);
      if (p.z > NEAR && Math.hypot(p.x - 200, p.y - 220) < 40) s.gazeHold = now + 4000;

      const startled = now < s.startleUntil;
      let target: number;
      if (startled) target = 0;
      else if (now - s.lastHand > IDLE_AFTER) target = now < s.gazeHold ? 1 : reducedMotion ? 0.3 : 0.5 + 0.5 * Math.sin(s.t * 0.42);
      else target = clamp(1 - (Math.hypot(s.hx - 198, s.hy - 300) - 30) / 170);
      s.g += (target - s.g) * ease(startled ? 0.1 : 0.035);

      const xrIdle = now - s.lastXr > IDLE_AFTER;
      const yawT = xrIdle ? (reducedMotion ? 0 : 0.42 * Math.sin(s.t * 0.22)) : s.yawT;
      const pitchT = xrIdle ? (reducedMotion ? 0 : 0.1 * Math.sin(s.t * 0.15)) : s.pitchT;
      s.yaw += (yawT - s.yaw) * ease(0.04);
      s.pitch += (pitchT - s.pitch) * ease(0.04);

      if (now - s.noiseAt > 160) {
        s.noise = [Math.random(), Math.random(), Math.random()];
        s.noiseAt = now;
      }
    };

    // ---- Drawing ----
    const render = (now: number) => {
      const g = s.g;
      const mult = s.mode === 'pinch' ? pinchMult(s.pinch) : MULT[s.mode];
      const startled = now < s.startleUntil;
      const handIdle = now - s.lastHand > IDLE_AFTER;
      const xrIdle = now - s.lastXr > IDLE_AFTER;
      const seq = (delay: number) => clamp((g - delay) / 0.6);
      const dot = (x: number, y: number) => `M ${r(x)} ${r(y)} l 0 0.01 `;

      // Hand: the thumb closes last, the fingers in sequence from the index.
      const flex: number[] = [];
      let joints = '', tips = '', tendons = '';
      const ft = thumbSeq(g) * mult[0];
      flex.push(ft);
      let a = (-128 + ft * 72) * D, x = 124, y = 346;
      const thumbLen = [38, 30, 24], thumbBend = [0, 34, 30];
      let thumb = `M ${x} ${y}`;
      joints += dot(x, y);
      for (let j = 0; j < 3; j++) {
        a += thumbBend[j] * ft * D;
        x += thumbLen[j] * Math.cos(a);
        y += thumbLen[j] * Math.sin(a);
        thumb += ` L ${r(x)} ${r(y)}`;
        if (j < 2) joints += dot(x, y);
      }
      tips += dot(x, y);
      FINGERS.forEach((f, i) => {
        const fl = seq(0.1 * i) * mult[i + 1];
        flex.push(fl);
        const bend = [85 * fl, 185 * fl, 260 * fl];
        let cx = f.bx, cy = KNUCKLE_Y, path = `M ${cx} ${cy}`;
        joints += dot(cx, cy);
        for (let j = 0; j < 3; j++) {
          cy -= f.L[j] * Math.cos(bend[j] * D);
          cx += j > 0 ? 3 * fl : 0;
          path += ` L ${r(cx)} ${r(cy)}`;
          if (j < 2) joints += dot(cx, cy);
        }
        tips += dot(cx, cy);
        attr('f' + i, 'd', path);
        tendons += path + ' ';
      });
      attr('f4', 'd', thumb);
      attr('tendons', 'd', tendons + thumb);
      attr('joints', 'd', joints);
      attr('tips', 'd', tips);

      const lift = startled ? 0 : liftOf(g);
      const picked = lift > 0.5;
      const contactF = startled ? 0 : FMAX[s.mode] * lift * lift;
      const tendonF = 1.5 + flex[1] * 6 + contactF * 2.2;
      attr('contact', 'opacity', r(lift));
      attr('cursor', 'opacity', handIdle ? 0 : 1);
      attr('cursorDot', 'cx', r(s.hx));
      attr('cursorDot', 'cy', r(s.hy));
      flex.forEach((v, i) => {
        text('deg' + i, Math.round(v * (i === 0 ? 72 : 85)));
        width('bar' + i, Math.round(v * 100));
      });
      text('gripN', r(contactF + (contactF > 0.2 ? (s.noise[0] - 0.5) * 0.3 : 0)));
      text('tendonN', r(tendonF));
      text('hMode', startled ? 'YIELD' : handIdle ? (reducedMotion ? 'IDLE' : 'IDLE DEMO') : 'TRACKING YOU');
      attr('hMode', 'data-state', startled ? 'alert' : handIdle ? 'idle' : 'live');
      const closing =
        s.mode === 'pinch' ? `Pinching: thumb → ${PINCH_FINGERS[s.pinch]}` : s.mode === 'point' ? 'Pointing: index out, the rest closed' : 'Closing: index → middle → ring → pinky → thumb';
      text('robotResp', startled ? 'Open hand, hold still, yield' : picked ? 'Grasp closed — picking the XR target' : g > 0.05 ? closing : 'Open, waiting');

      // Headset view: a floor grid, two landmarks, the grasp target and the hand proxy.
      const seg = (from: number[], to: number[]) => {
        let d = '', pen = false;
        for (let i = 0; i <= 12; i++) {
          const u = i / 12;
          const q = project(from[0] + (to[0] - from[0]) * u, from[1] + (to[1] - from[1]) * u, from[2] + (to[2] - from[2]) * u);
          if (q.z > NEAR) {
            d += `${pen ? ' L' : ' M'} ${r(q.x)} ${r(q.y)}`;
            pen = true;
          } else pen = false;
        }
        return d;
      };
      let grid = '';
      for (let gx = -5; gx <= 5; gx++) grid += seg([gx * 0.8, -1.1, 0.6], [gx * 0.8, -1.1, 14]);
      for (let gz = 1; gz <= 14; gz++) grid += seg([-4, -1.1, gz], [4, -1.1, gz]);
      attr('xrGrid', 'd', grid);

      const C = cubeCentre(lift), half = 0.22;
      const V = Array.from({ length: 8 }, (_, i) => project(C[0] + (i & 1 ? half : -half), C[1] + (i & 2 ? half : -half), C[2] + (i & 4 ? half : -half)));
      const cubeOk = V.every((q) => q.z > NEAR);
      const at = (i: number) => `${r(V[i].x)} ${r(V[i].y)}`;
      const EDGES = [[0, 1], [1, 3], [3, 2], [2, 0], [4, 5], [5, 7], [7, 6], [6, 4], [0, 4], [1, 5], [2, 6], [3, 7]];
      const FACES = [[0, 1, 3, 2], [0, 1, 5, 4], [2, 3, 7, 6]];
      const pc = project(C[0], C[1], C[2]);
      const gazeDist = Math.hypot(pc.x - 200, pc.y - 220);
      const gazeOn = cubeOk && gazeDist < 40;
      const hot = picked || gazeOn;
      attr('cubeEdges', 'd', cubeOk ? EDGES.map((e) => `M ${at(e[0])} L ${at(e[1])}`).join(' ') : '');
      attr('cubeFaces', 'd', cubeOk ? FACES.map((f) => `M ${f.map(at).join(' L ')} Z`).join(' ') : '');
      flag('cubeEdges', 'hot', hot);
      flag('cubeFaces', 'hot', hot);
      flag('cubeLabel', 'hot', hot);
      // The cube steps through the same three looks as the landmarks.
      const cubeLook = MARK_STATES[marks.cube.at];
      attr('cubeEdges', 'stroke-dasharray', cubeLook === 'dashed' ? '5 6' : 'none');
      attr('cubeFaces', 'fill-opacity', cubeLook === 'full' ? 0.26 : hot ? 0.1 : 0);
      attr('cubeLabel', 'x', r(pc.x + 34));
      attr('cubeLabel', 'y', r(pc.y - 4));
      text('cubeLabel', cubeOk ? (picked ? `PICKED · ${r(contactF)} N` : gazeOn ? 'SELECTED · 0.91 m' : 'GRASP TARGET') : '');

      // The two landmarks, and which one the reticle is resting on.
      const sphere = project(1.2, 0.25, 4.4), ring = project(-1.8, 0.55, 5.2);
      const sphereR = sphere.z > NEAR ? (FL * 0.3) / sphere.z : 0;
      const ringR = ring.z > NEAR ? (FL * 0.38) / ring.z : 0;
      attr('sphere', 'cx', r(sphere.x));
      attr('sphere', 'cy', r(sphere.y));
      attr('sphere', 'r', r(sphereR));
      attr('ring', 'cx', r(ring.x));
      attr('ring', 'cy', r(ring.y));
      attr('ring', 'r', r(ringR));
      // A wider edge once a landmark is held, so a small drift does not drop it.
      const onMark = (q: { x: number; y: number }, rad: number, k: string) =>
        rad > 0 && Math.hypot(q.x - 200, q.y - 220) < rad + (s.aim === k ? 24 : 6);
      s.aim = gazeOn ? 'cube' : onMark(sphere, sphereR, 'sphere') ? 'sphere' : onMark(ring, ringR, 'ring') ? 'ring' : '';
      if (s.aim) {
        s.lastAim = s.aim;
        s.aimAt = now;
      }
      flag('sphere', 'aimed', s.aim === 'sphere');
      flag('ring', 'aimed', s.aim === 'ring');

      // The hand proxy hovers beside the target and moves in as the real hand closes.
      const approach = clamp(g / 0.85), far = 1 - approach;
      const bob = reducedMotion ? 0 : Math.sin(s.t * 1.1) * 0.04 * far;
      const proxy = project(C[0] + 0.6 * far, C[1] + 0.5 * far + bob, C[2] - 0.35 * far);
      const seen = proxy.z > NEAR;
      const px = r(seen ? proxy.x : -50), py = r(seen ? proxy.y : -50);
      for (const key of ['proxyHalo', 'proxyPing', 'proxyDot']) {
        attr(key, 'cx', px);
        attr(key, 'cy', py);
      }
      attr('proxyDot', 'r', r(seen ? Math.max(3, (FL * 0.022) / proxy.z) : 0));
      attr('proxyHalo', 'r', r(seen ? (FL * 0.08) / proxy.z : 0));
      attr('proxyLine', 'x1', px);
      attr('proxyLine', 'y1', py);
      attr('proxyLine', 'x2', r(pc.x));
      attr('proxyLine', 'y2', r(pc.y));
      attr('proxyLine', 'opacity', picked || !cubeOk ? 0 : 0.6);
      text('linkLabel', 'HAND PROXY · ' + (picked ? 'HOLDING' : approach > 0.3 ? 'APPROACHING' : 'HOVERING'));

      attr('reticle', 'r', gazeOn ? 16 : 10);
      flag('reticle', 'hot', gazeOn);
      flag('reticleDot', 'hot', gazeOn);
      attr('reticlePing', 'opacity', gazeOn ? 1 : 0);
      text('hudHaptic', picked ? 'GRIP FORCE MIRRORED → FINGERTIP' : gazeOn ? 'HAPTIC CUE → FINGERTIP' : 'HAPTIC IDLE');
      text('yawDeg', r(s.yaw / D));
      text('pitchDeg', r(s.pitch / D));
      text('m2p', r(17.6 + s.noise[2] * 2.4));
      text('hapMm', (picked ? 0.8 + lift * 1.2 : gazeOn ? 0.9 - (gazeDist / 40) * 0.4 : 0).toFixed(1));
      text('gazeState', gazeOn ? 'Fixating on target' : s.aim ? 'Resting on a landmark' : xrIdle ? 'Scanning the scene' : 'Searching');
      text(
        'xrResp',
        picked
          ? 'Object picked · grip mirrored to fingertip'
          : gazeOn
            ? 'Target locked · click to change its look'
            : s.aim
              ? 'Landmark in the reticle · click to change its look'
              : 'Reticle free · no cue',
      );
      text('xrMode', xrIdle ? (reducedMotion ? 'IDLE' : 'IDLE DEMO') : 'HEAD TRACKED');
      attr('xrMode', 'data-state', xrIdle ? 'idle' : 'alert');
    };

    // ---- Input ----
    const handStage = root.querySelector<HTMLElement>('[data-stage="hand"]')!;
    const handSvg = handStage.querySelector('svg')!;
    handStage.addEventListener('pointermove', (e) => {
      const matrix = handSvg.getScreenCTM();
      if (!matrix) return;
      const point = new DOMPoint(e.clientX, e.clientY).matrixTransform(matrix.inverse());
      const now = Date.now(), prev = s.prevMove;
      // A fast swipe towards the hand startles it: it opens and holds still.
      if (prev && now - prev.t > 0 && now - prev.t < 200 && Math.hypot(e.clientX - prev.x, e.clientY - prev.y) / (now - prev.t) > 2.2) {
        s.startleUntil = now + 900;
      }
      s.hx = point.x;
      s.hy = point.y;
      s.lastHand = now;
      s.prevMove = { x: e.clientX, y: e.clientY, t: now };
    });
    // Tapping a finger in the drawing pinches it against the thumb.
    handStage.addEventListener('click', (e) => {
      const picked = (e.target as Element).closest<SVGElement>('[data-finger]');
      if (!picked) return;
      s.pinch = Number(picked.dataset.finger);
      setGrasp('pinch');
    });
    handStage.addEventListener('pointerleave', () => {
      s.lastHand = 0;
      s.prevMove = null;
    });

    const xrStage = root.querySelector<HTMLElement>('[data-stage="xr"]')!;
    xrStage.addEventListener('pointermove', (e) => {
      const box = xrStage.getBoundingClientRect();
      s.yawT = ((e.clientX - box.left) / box.width - 0.5) * 1.3;
      s.pitchT = -((e.clientY - box.top) / box.height - 0.5) * 0.7;
      s.lastXr = Date.now();
    });
    xrStage.addEventListener('pointerleave', () => (s.lastXr = 0));
    // The three looks a landmark steps through, and where each one has got to.
    const MARK_STATES = ['dashed', 'outline', 'full'];
    const marks: Record<string, { at: number; dir: number }> = {
      ring: { at: 0, dir: 1 },
      sphere: { at: 1, dir: 1 },
      cube: { at: 1, dir: 1 },
    };
    // Rest the reticle on a landmark, then click anywhere in the view to step it along.
    xrStage.addEventListener('click', () => {
      // The click counts for whatever the reticle held in the past half second.
      const mark = s.aim || (Date.now() - s.aimAt < 500 ? s.lastAim : '');
      if (!mark) return;
      // Step one place along the sequence, turning round at either end.
      const step = marks[mark];
      step.at += step.dir;
      if (step.at >= MARK_STATES.length - 1) (step.at = MARK_STATES.length - 1), (step.dir = -1);
      if (step.at <= 0) (step.at = 0), (step.dir = 1);
      // The cube is redrawn every frame, so only the two circles carry the look as an attribute.
      if (mark !== 'cube') root.querySelector(`[data-k="${mark}"]`)?.setAttribute('data-state', MARK_STATES[step.at]);
      // Restart the pop so repeated clicks keep answering.
      const popping = mark === 'cube' ? ['cubeEdges', 'cubeFaces'] : [mark];
      for (const key of popping) {
        const el = root.querySelector(`[data-k="${key}"]`);
        if (!el) continue;
        el.classList.remove('pop');
        void el.getBoundingClientRect();
        el.classList.add('pop');
      }
    });

    const graspButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-grasp]')];
    const pinchButton = graspButtons.find((b) => b.dataset.grasp === 'pinch');
    const fingerPaths = [...root.querySelectorAll<SVGElement>('[data-finger]')];
    const setGrasp = (mode: Grasp) => {
      s.mode = mode;
      graspButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.grasp === mode)));
      pinchButton?.setAttribute('aria-label', `Pinch, thumb against the ${PINCH_FINGERS[s.pinch]} finger. Press again for the next finger.`);
      fingerPaths.forEach((f) => f.classList.toggle('picked', mode === 'pinch' && Number(f.dataset.finger) === s.pinch));
    };
    setGrasp(s.mode);
    for (const button of graspButtons) {
      button.addEventListener('click', () => {
        const mode = button.dataset.grasp as Grasp;
        // Pressing "Pinch" again moves the thumb on to the next finger.
        if (mode === 'pinch' && s.mode === 'pinch') s.pinch = (s.pinch + 1) % PINCH_FINGERS.length;
        setGrasp(mode);
      });
    }

    // ---- Loop: runs only while the lab is on screen and the tab is visible ----
    let visible = true, frame = 0, previous = 0;
    const loop = (time: number) => {
      const dt = Math.min(100, previous ? time - previous : 16);
      previous = time;
      const now = Date.now();
      step(dt / 40, now);
      render(now);
      frame = visible && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const wake = () => {
      if (!frame && visible && !document.hidden) {
        previous = 0;
        frame = requestAnimationFrame(loop);
      }
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      wake();
    }).observe(root);
    document.addEventListener('visibilitychange', wake);
    render(Date.now());
    wake();
  }
</script>

